{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peteywee/TSAL/schemas/CONFORMANCE-REPORT.schema.json",
  "title": "TSAL Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "tsal_version", "evaluated_at", "evaluator", "result", "summary", "checks"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.3"},
    "project_id": {"type": "string", "minLength": 1},
    "automation_id": {"type": ["string", "null"]},
    "tsal_version": {"type": "string", "minLength": 1},
    "candidate": {"type": ["string", "null"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "evaluator": {"type": "string", "minLength": 1},
    "result": {"type": "string", "enum": ["proven", "partial", "unproven", "blocking"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proven", "partial", "unproven", "blocking", "not_applicable"],
      "properties": {
        "proven": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "unproven": {"type": "integer", "minimum": 0},
        "blocking": {"type": "integer", "minimum": 0},
        "not_applicable": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement", "result", "required_evidence_classes", "evidence_refs", "notes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1},
          "result": {"type": "string", "enum": ["proven", "partial", "unproven", "blocking", "not_applicable"]},
          "required_evidence_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["specification", "implementation", "candidate", "deployment", "runtime", "reconciliation", "attestation"]}
          },
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    },
    "blocking_findings": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
