{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peteywee/TSAL/AUTOMATION-CONTRACT.schema.json",
  "title": "TSAL Automation Contract",
  "description": "Technology-agnostic operating contract for a TSAL-governed automation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "automation",
    "goal",
    "trigger",
    "source_of_truth",
    "work_item",
    "risk",
    "authority",
    "side_effects",
    "state",
    "ambiguity",
    "retry",
    "verification",
    "recovery",
    "owner_reserved_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "owner"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "success_condition", "correct_non_execution"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1},
        "success_condition": {"type": "string", "minLength": 1},
        "correct_non_execution": {"type": "string", "minLength": 1}
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "schedule",
            "event",
            "state_change",
            "threshold",
            "webhook",
            "dependency_completion",
            "manual",
            "condition",
            "other"
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "cadence_or_condition": {"type": "string"}
      }
    },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "location", "owner"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "derived_artifacts_rebuildable": {"type": "boolean"}
      }
    },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "identity_key"],
      "properties": {
        "definition": {"type": "string", "minLength": 1},
        "identity_key": {"type": "string", "minLength": 1},
        "selection_rule": {"type": "string"},
        "maximum_per_execution": {"type": "integer", "minimum": 1}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "rationale"],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["R0", "R1", "R2", "R3"]
        },
        "rationale": {"type": "string", "minLength": 1},
        "worst_credible_effect": {"type": "string"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "production_authority", "concurrency_model", "revocation_mechanism"],
      "properties": {
        "executor": {"type": "string", "minLength": 1},
        "production_authority": {"type": "string", "minLength": 1},
        "concurrency_model": {
          "type": "string",
          "enum": ["single", "coordinated_multi", "none_read_only"]
        },
        "coordination_mechanism": {"type": "string"},
        "revocation_mechanism": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "description": {"type": "string"},
        "change_authority": {"type": "string"}
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "operation", "reversible", "ambiguity_possible"],
        "properties": {
          "system": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "reversible": {"type": "boolean"},
          "ambiguity_possible": {"type": "boolean"},
          "idempotency_strategy": {"type": "string"},
          "maximum_scope": {"type": "string"}
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger", "durable", "states", "write_safety"],
      "properties": {
        "ledger": {"type": "string", "minLength": 1},
        "durable": {"type": "boolean"},
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "write_safety": {"type": "string", "minLength": 1},
        "intent_recorded_before_side_effect": {"type": "boolean"}
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["possible", "detection", "on_unknown", "reconciliation"],
      "properties": {
        "possible": {"type": "boolean"},
        "detection": {"type": "string", "minLength": 1},
        "on_unknown": {"type": "string", "minLength": 1},
        "reconciliation": {"type": "string", "minLength": 1},
        "automatic_retry_allowed_when_unknown": {"type": "boolean", "default": false}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "maximum_attempts", "retryable_conditions", "non_retryable_conditions"],
      "properties": {
        "strategy": {"type": "string", "minLength": 1},
        "maximum_attempts": {"type": "integer", "minimum": 0},
        "backoff": {"type": "string"},
        "retryable_conditions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "non_retryable_conditions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "backlog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stale_definition": {"type": "string"},
        "automatic_catchup_allowed": {"type": "boolean"},
        "permitted_dispositions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["retry", "defer", "skip", "cancel", "replace", "escalate", "reconcile"]
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight", "dry_run", "postcondition", "runtime_health", "evidence"],
      "properties": {
        "preflight": {"type": "string", "minLength": 1},
        "dry_run": {"type": "string", "minLength": 1},
        "postcondition": {"type": "string", "minLength": 1},
        "runtime_health": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procedure", "fail_closed_conditions", "resume_gate"],
      "properties": {
        "procedure": {"type": "string", "minLength": 1},
        "fail_closed_conditions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "resume_gate": {"type": "string", "minLength": 1}
      }
    },
    "owner_reserved_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logs": {"type": "string"},
        "metrics": {"type": "string"},
        "alerts": {"type": "string"}
      }
    },
    "lesson_loop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "incident_record_location": {"type": "string"},
        "standard_promotion_process": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk": {
            "properties": {
              "class": {"enum": ["R2", "R3"]}
            },
            "required": ["class"]
          }
        }
      },
      "then": {
        "properties": {
          "side_effects": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority": {
            "properties": {
              "concurrency_model": {"const": "coordinated_multi"}
            },
            "required": ["concurrency_model"]
          }
        }
      },
      "then": {
        "properties": {
          "authority": {
            "required": ["coordination_mechanism"]
          }
        }
      }
    }
  ]
}
